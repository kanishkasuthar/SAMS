# Server Settings
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://sams.yourcompany.com

# Database Settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sams_db

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email / OTP Settings (Nodemailer)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email@ethereal.email
EMAIL_PASS=your_email_password
